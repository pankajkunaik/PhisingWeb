# ─────────────────────────────────────────────
# PhishGuard AI — Backend Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret

# Database — SQLite (dev) or PostgreSQL (prod)
DATABASE_URL=sqlite:///./phishguard.db
# DATABASE_URL=postgresql://user:password@localhost:5432/phishguard

# Redis — optional caching layer
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Threat Intel API Keys (optional — enables real feeds)
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_APP_KEY=

# App config
APP_ENV=development
PORT=8000
