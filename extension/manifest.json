{
  "manifest_version": 3,
  "name": "PhishGuard AI - Threat Detector",
  "version": "1.0.0",
  "description": "Real-time AI-powered phishing website detection and security ratings.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
